                                                               <http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#python_name> "response_visit_occurrence" ;
                                                               rdfs:comment "For Survey Conduct: The Visit during which any treatment related to the Survey was carried out."@en ;
                                                               rdfs:label "Has response visit occurrence" ;
                                                               <https://w3id.org/omop/ontology/omop_cdm_name> "survey_conduct.response_visit_occurrence_id#250 AS VisitOccurrence" .


###  https://w3id.org/omop/ontology/has_revenue_code
<https://w3id.org/omop/ontology/has_revenue_code> rdf:type owl:ObjectProperty ,
                                                           owl:FunctionalProperty ;
                                                  rdfs:domain <https://w3id.org/omop/ontology/Cost> ;
