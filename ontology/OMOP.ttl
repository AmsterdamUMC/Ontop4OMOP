                                                       rdfs:domain <https://w3id.org/omop/ontology/SourceToConceptMap> ;
                                                       rdfs:range <https://w3id.org/omop/ontology/Vocabulary> ;
                                                       <http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#python_name> "target_vocabulary" ;
                                                       rdfs:comment "For Source To Concept Map: The Vocabulary of the target Concept."@en ;
                                                       rdfs:label "Has target vocabulary" ;
                                                       <https://w3id.org/omop/ontology/omop_cdm_name> "source_to_concept_map.target_vocabulary_id#407 AS Vocabulary" .


###  https://w3id.org/omop/ontology/has_timing
<https://w3id.org/omop/ontology/has_timing> rdf:type owl:ObjectProperty ,
                                                     owl:FunctionalProperty ;
                                            rdfs:domain <https://w3id.org/omop/ontology/SurveyConduct> ;
                                            rdfs:range <https://w3id.org/omop/ontology/Concept> ;
                                            <http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#python_name> "timing" ;
                                            rdfs:comment """For Survey Conduct: This is a Concept that represents the timing of the survey. For example this could be the 3-month follow-up appointment.
There is no specific domain or class for this field, just choose the one that best represents the value given in the source."""@en ;
                                            rdfs:label "Has timing" ;
                                            <https://w3id.org/omop/ontology/omop_cdm_name> "survey_conduct.timing_concept_id#237 AS Concept" .


###  https://w3id.org/omop/ontology/has_type
<https://w3id.org/omop/ontology/has_type> rdf:type owl:ObjectProperty ,
                                                   owl:FunctionalProperty ;
                                          rdfs:domain [ rdf:type owl:Class ;
                                                        owl:unionOf ( <https://w3id.org/omop/ontology/BaseVisit>
                                                                      <https://w3id.org/omop/ontology/ConditionOccurrence>
                                                                      <https://w3id.org/omop/ontology/Cost>
                                                                      <https://w3id.org/omop/ontology/Death>
                                                                      <https://w3id.org/omop/ontology/Exposure>
                                                                      <https://w3id.org/omop/ontology/Measurement>
                                                                      <https://w3id.org/omop/ontology/Metadata>
                                                                      <https://w3id.org/omop/ontology/Note>
                                                                      <https://w3id.org/omop/ontology/Observation>
                                                                      <https://w3id.org/omop/ontology/ProcedureOccurrence>
                                                                      <https://w3id.org/omop/ontology/Specimen>
                                                                    )
                                                      ] ;
                                          rdfs:range <https://w3id.org/omop/ontology/Concept> ;
                                          <http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#python_name> "type" ;
                                          rdfs:comment """For Condition Occurrence: This field can be used to determine the provenance of the Condition record, as in whether the condition was from an EHR system, insurance claim, registry, or other sources.
Choose the condition_type_concept_id that best represents the provenance of the record. [Accepted Concepts](https://athena.ohdsi.org/search-terms/terms?domain=Type+Concept&standardConcept=Standard&page=1&pageSize=15&query=)."""@en ,
                                                       "For Cost: A foreign key identifier to a concept in the CONCEPT table for the provenance or the source of the COST data and belonging to the 'Type Concept' vocabulary"@en ,
                                                       """For Device Exposure: You can use the TYPE_CONCEPT_ID to denote the provenance of the record, as in whether the record is from administrative claims or EHR. [Accepted Concepts](https://athena.ohdsi.org/search-terms/terms?domain=Type+Concept&standardConcept=Standard&page=1&pageSize=15&query=).
Choose the drug_type_concept_id that best represents the provenance of the record, for example whether it came from a record of a prescription written or physician administered drug."""@en ,
                                                       """For Drug Exposure: You can use the TYPE_CONCEPT_ID to delineate between prescriptions written vs. prescriptions dispensed vs. medication history vs. patient-reported exposure, etc.
Choose the drug_type_concept_id that best represents the provenance of the record, for example whether it came from a record of a prescription written or physician administered drug. [Accepted Concepts](https://athena.ohdsi.org/search-terms/terms?domain=Type+Concept&standardConcept=Standard&page=1&pageSize=15&query=)."""@en ,
                                                       """For Measurement: This field can be used to determine the provenance of the Measurement record, as in whether the measurement was from an EHR system, insurance claim, registry, or other sources.
Choose the MEASUREMENT_TYPE_CONCEPT_ID that best represents the provenance of the record, for example whether it came from an EHR record or billing claim. [Accepted Concepts](https://athena.ohdsi.org/search-terms/terms?domain=Type+Concept&standardConcept=Standard&page=1&pageSize=15&query=)."""@en ,
                                                       """For Note: The provenance of the note. Most likely this will be EHR.
Put the source system of the note, as in EHR record. [Accepted Concepts](https://athena.ohdsi.org/search-terms/terms?standardConcept=Standard&domain=Type+Concept&page=1&pageSize=15&query=)."""@en ,
                                                       """For Observation: This field can be used to determine the provenance of the Observation record, as in whether the measurement was from an EHR system, insurance claim, registry, or other sources.
Choose the OBSERVATION_TYPE_CONCEPT_ID that best represents the provenance of the record, for example whether it came from an EHR record or billing claim. [Accepted Concepts](https://athena.ohdsi.org/search-terms/terms?domain=Type+Concept&standardConcept=Standard&page=1&pageSize=15&query=)."""@en ,
                                                       """For Procedure Occurrence: This field can be used to determine the provenance of the Procedure record, as in whether the procedure was from an EHR system, insurance claim, registry, or other sources.
Choose the PROCEDURE_TYPE_CONCEPT_ID that best represents the provenance of the record, for example whether it came from an EHR record or billing claim. If a procedure is recorded as an EHR encounter, the PROCEDURE_TYPE_CONCEPT would be 'EHR encounter record'. [Accepted Concepts](https://athena.ohdsi.org/search-terms/terms?domain=Type+Concept&standardConcept=Standard&page=1&pageSize=15&query=)."""@en ,
                                                       "For Specimen: Put the source of the specimen record, as in an EHR system. [Accepted Concepts](https://athena.ohdsi.org/search-terms/terms?standardConcept=Standard&domain=Type+Concept&page=1&pageSize=15&query=)."@en ,
                                                       """For Visit Detail: Use this field to understand the provenance of the visit detail record, or where the record comes from.
Populate this field based on the provenance of the visit detail record, as in whether it came from an EHR record or billing claim. [Accepted Concepts](https://athena.ohdsi.org/search-terms/terms?domain=Type+Concept&standardConcept=Standard&page=1&pageSize=15&query=)."""@en ,
                                                       """For Visit Occurrence: Use this field to understand the provenance of the visit record, or where the record comes from.
Populate this field based on the provenance of the visit record, as in whether it came from an EHR record or billing claim."""@en ;
                                          rdfs:label "Has type" ;
                                          <https://w3id.org/omop/ontology/omop_cdm_name> "condition_occurrence.condition_type_concept_id#68 AS Concept" ,
                                                                                         "cost.cost_type_concept_id#312 AS Concept" ,
                                                                                         "death.death_type_concept_id#173 AS Concept" ,
                                                                                         "device_exposure.device_type_concept_id#121 AS Concept" ,
                                                                                         "drug_exposure.drug_type_concept_id#85 AS Concept" ,
                                                                                         "measurement.measurement_type_concept_id#135 AS Concept" ,
                                                                                         "metadata.metadata_type_concept_id#346 AS Concept" ,
                                                                                         "note.note_type_concept_id#183 AS Concept" ,
                                                                                         "observation.observation_type_concept_id#154 AS Concept" ,
                                                                                         "procedure_occurrence.procedure_type_concept_id#105 AS Concept" ,
                                                                                         "specimen.specimen_type_concept_id#210 AS Concept" ,
                                                                                         "visit_detail.visit_detail_type_concept_id#49 AS Concept" ,
                                                                                         "visit_occurrence.visit_type_concept_id#32 AS Concept" .


###  https://w3id.org/omop/ontology/has_unique_device
<https://w3id.org/omop/ontology/has_unique_device> rdf:type owl:ObjectProperty ,
                                                            owl:FunctionalProperty ;
                                                   rdfs:domain <https://w3id.org/omop/ontology/DeviceExposure> ;
                                                   <http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#python_name> "unique_device" ;
                                                   rdfs:comment """For Device Exposure: This is the Unique Device Identification number for devices regulated by the FDA, if given.
For medical devices that are regulated by the FDA, a Unique Device Identification (UDI) is provided if available in the data source and is recorded in the UNIQUE_DEVICE_ID field."""@en ;
                                                   rdfs:label "Has unique device" ;
                                                   <https://w3id.org/omop/ontology/omop_cdm_name> "device_exposure.unique_device_id#122 AS Thing" .


###  https://w3id.org/omop/ontology/has_unit
<https://w3id.org/omop/ontology/has_unit> rdf:type owl:ObjectProperty ,
                                                   owl:FunctionalProperty ;
                                          rdfs:domain [ rdf:type owl:Class ;
                                                        owl:unionOf ( <https://w3id.org/omop/ontology/DoseEra>
                                                                      <https://w3id.org/omop/ontology/Measurement>
                                                                      <https://w3id.org/omop/ontology/Observation>
                                                                      <https://w3id.org/omop/ontology/Specimen>
                                                                    )
                                                      ] ;
                                          rdfs:range <https://w3id.org/omop/ontology/Concept> ;
                                          <http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#python_name> "unit" ;
                                          rdfs:comment "For Dose Era: The Concept Id representing the unit of the specific drug ingredient."@en ,
                                                       """For Measurement: There is currently no recommended unit for individual measurements, i.e. it is not mandatory to represent Hemoglobin a1C measurements as a percentage. UNIT_SOURCE_VALUES should be mapped to a Standard Concept in the Unit domain that best represents the unit as given in the source data.
There is no standardization requirement for units associated with MEASUREMENT_CONCEPT_IDs, however, it is the responsibility of the ETL to choose the most plausible unit."""@en ,
                                                       """For Observation: There is currently no recommended unit for individual observation concepts. UNIT_SOURCE_VALUES should be mapped to a Standard Concept in the Unit domain that best represents the unit as given in the source data.
There is no standardization requirement for units associated with OBSERVATION_CONCEPT_IDs, however, it is the responsibility of the ETL to choose the most plausible unit."""@en ,
                                                       """For Specimen: The unit for the quantity of the specimen.
Map the UNIT_SOURCE_VALUE to a Standard Concept in the Unit domain. [Accepted Concepts](https://athena.ohdsi.org/search-terms/terms?domain=Unit&standardConcept=Standard&page=1&pageSize=15&query=)"""@en ;
                                          rdfs:label "Has unit" ;
                                          <https://w3id.org/omop/ontology/omop_cdm_name> "dose_era.unit_concept_id#335 AS Concept" ,
                                                                                         "measurement.unit_concept_id#139 AS Concept" ,
                                                                                         "observation.unit_concept_id#159 AS Concept" ,
                                                                                         "specimen.unit_concept_id#214 AS Concept" .


###  https://w3id.org/omop/ontology/has_validated_survey
<https://w3id.org/omop/ontology/has_validated_survey> rdf:type owl:ObjectProperty ,
                                                               owl:FunctionalProperty ;
                                                      rdfs:domain <https://w3id.org/omop/ontology/SurveyConduct> ;
                                                      rdfs:range <https://w3id.org/omop/ontology/Concept> ;
                                                      <http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#python_name> "validated_survey" ;
                                                      rdfs:comment "For Survey Conduct: If unavailable, set to 0."@en ;
                                                      rdfs:label "Has validated survey" ;
                                                      <https://w3id.org/omop/ontology/omop_cdm_name> "survey_conduct.validated_survey_concept_id#246 AS Concept" .


###  https://w3id.org/omop/ontology/has_value_as_concept
<https://w3id.org/omop/ontology/has_value_as_concept> rdf:type owl:ObjectProperty ,
                                                               owl:FunctionalProperty ;
                                                      rdfs:domain [ rdf:type owl:Class ;
                                                                    owl:unionOf ( <https://w3id.org/omop/ontology/Measurement>
                                                                                  <https://w3id.org/omop/ontology/Metadata>
                                                                                  <https://w3id.org/omop/ontology/Observation>
                                                                                )
                                                                  ] ;
                                                      rdfs:range <https://w3id.org/omop/ontology/Concept> ;
                                                      <http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#python_name> "value_as_concept" ;
                                                      rdfs:comment """For Measurement: If the raw data gives a categorial result for measurements those values are captured and mapped to standard concepts in the 'Meas Value' domain.
If the raw data provides categorial results as well as continuous results for measurements, it is a valid ETL choice to preserve both values. The continuous value should go in the VALUE_AS_NUMBER field and the categorical value should be mapped to a standard concept in the 'Meas Value' domain and put in the VALUE_AS_CONCEPT_ID field. This is also the destination for the 'Maps to value' relationship."""@en ,
                                                                   """For Observation: It is possible that some records destined for the Observation table have two clinical ideas represented in one source code. This is common with ICD10 codes that describe a family history of some Condition, for example. In OMOP the Vocabulary breaks these two clinical ideas into two codes; one becomes the OBSERVATION_CONCEPT_ID and the other becomes the VALUE_AS_CONCEPT_ID. It is important when using the Observation table to keep this possibility in mind and to examine the VALUE_AS_CONCEPT_ID field for relevant information.
Note that the value of VALUE_AS_CONCEPT_ID may be provided through mapping from a source Concept which contains the content of the Observation. In those situations, the CONCEPT_RELATIONSHIP table in addition to the 'Maps to' record contains a second record with the relationship_id set to 'Maps to value'. For example, ICD10 [Z82.4](https://athena.ohdsi.org/search-terms/terms/45581076) 'Family history of ischaemic heart disease and other diseases of the circulatory system' has a 'Maps to' relationship to [4167217](https://athena.ohdsi.org/search-terms/terms/4167217) 'Family history of clinical finding' as well as a 'Maps to value' record to [134057](https://athena.ohdsi.org/search-terms/terms/134057) 'Disorder of cardiovascular system'."""@en ;
                                                      rdfs:label "Has value as concept" ;
                                                      <https://w3id.org/omop/ontology/omop_cdm_name> "measurement.value_as_concept_id#138 AS Concept" ,
                                                                                                     "metadata.value_as_concept_id#349 AS Concept" ,
