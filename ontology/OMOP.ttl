                                                          owl:allValuesFrom <https://w3id.org/omop/ontology/DrugExposure>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/omop/ontology/has_ethnicity> ;
                                                          owl:allValuesFrom <https://w3id.org/omop/ontology/Concept>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/omop/ontology/has_ethnicity_source> ;
                                                          owl:allValuesFrom <https://w3id.org/omop/ontology/Concept>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/omop/ontology/has_location> ;
                                                          owl:allValuesFrom <https://w3id.org/omop/ontology/Location>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/omop/ontology/has_measurement> ;
                                                          owl:allValuesFrom <https://w3id.org/omop/ontology/Measurement>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/omop/ontology/has_note> ;
                                                          owl:allValuesFrom <https://w3id.org/omop/ontology/Note>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/omop/ontology/has_observation> ;
                                                          owl:allValuesFrom <https://w3id.org/omop/ontology/Observation>
                                                        ] ,
