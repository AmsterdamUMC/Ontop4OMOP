                                                          <https://w3id.org/omop/ontology/omop_cdm_name> "relationship.reverse_relationship_id#393 AS Thing" .


###  https://w3id.org/omop/ontology/has_route
<https://w3id.org/omop/ontology/has_route> rdf:type owl:ObjectProperty ,
                                                    owl:FunctionalProperty ;
                                           rdfs:domain <https://w3id.org/omop/ontology/DrugExposure> ;
                                           rdfs:range <https://w3id.org/omop/ontology/Concept> ;
