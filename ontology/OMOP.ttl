                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://w3id.org/omop/ontology/has_gender> ;
                                                              owl:someValuesFrom <https://w3id.org/omop/ontology/Concept>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://w3id.org/omop/ontology/has_gender_source> ;
                                                              owl:someValuesFrom <https://w3id.org/omop/ontology/Concept>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://w3id.org/omop/ontology/has_care_site> ;
                                                              owl:allValuesFrom <https://w3id.org/omop/ontology/CareSite>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://w3id.org/omop/ontology/has_gender> ;
                                                              owl:allValuesFrom <https://w3id.org/omop/ontology/Concept>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://w3id.org/omop/ontology/has_gender_source> ;
                                                              owl:allValuesFrom <https://w3id.org/omop/ontology/Concept>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://w3id.org/omop/ontology/gender_source_value> ;
                                                              owl:allValuesFrom xsd:string
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://w3id.org/omop/ontology/source_value> ;
                                                              owl:allValuesFrom xsd:string
                                                            ] ;
