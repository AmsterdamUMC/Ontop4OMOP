                                                            owl:onProperty <https://w3id.org/omop/ontology/place_of_service_source_value> ;
                                                            owl:allValuesFrom xsd:string
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <https://w3id.org/omop/ontology/source_value> ;
                                                            owl:allValuesFrom xsd:string
                                                          ] ;
                                          rdfs:comment "The CARE_SITE table contains a list of uniquely identified institutional (physical or organizational) units where healthcare delivery is practiced (offices, wards, hospitals, clinics, etc.)."@en ;
                                          rdfs:label "Care site" ;
                                          <https://w3id.org/omop/ontology/omop_cdm_name> "care_site" .


