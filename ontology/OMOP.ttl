                                         rdfs:domain <https://w3id.org/omop/ontology/Vocabulary> ;
                                         rdfs:range xsd:string ;
                                         rdfs:comment """For Vocabulary: Version of the Vocabulary as indicated in
the source."""@en ;
                                         rdfs:label "Version" ;
                                         <https://w3id.org/omop/ontology/omop_cdm_name> "vocabulary.vocabulary_version#375 AS str" .


###  https://w3id.org/omop/ontology/vocabulary_version
