                                                   rdfs:label "Has survey source" ;
                                                   <https://w3id.org/omop/ontology/omop_cdm_name> "survey_conduct.survey_source_concept_id#244 AS Concept" .


###  https://w3id.org/omop/ontology/has_target
<https://w3id.org/omop/ontology/has_target> rdf:type owl:ObjectProperty ,
                                                     owl:FunctionalProperty ;
                                            rdfs:domain <https://w3id.org/omop/ontology/SourceToConceptMap> ;
                                            rdfs:range <https://w3id.org/omop/ontology/Concept> ;
                                            <http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#python_name> "target" ;
                                            rdfs:comment """For Source To Concept Map: The target Concept
to which the source code is being
mapped."""@en ;
                                            rdfs:label "Has target" ;
                                            <https://w3id.org/omop/ontology/omop_cdm_name> "source_to_concept_map.target_concept_id#406 AS Concept" .


