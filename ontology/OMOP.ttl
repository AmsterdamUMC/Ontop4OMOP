                                                                                <https://w3id.org/omop/ontology/VisitOccurrence>
                                                                              )
                                                                ] ;
                                                    rdfs:range <https://w3id.org/omop/ontology/SurveyConduct> ;
                                                    <http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#python_name> "survey_conducts" ;
                                                    rdfs:comment "reversed relation, For Survey Conduct: The Visit during which the Survey occurred."@en ;
