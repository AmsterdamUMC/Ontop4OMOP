                                                                owl:someValuesFrom xsd:date
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://w3id.org/omop/ontology/amount_value> ;
                                                                owl:allValuesFrom xsd:decimal
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://w3id.org/omop/ontology/box_size> ;
                                                                owl:allValuesFrom xsd:integer
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://w3id.org/omop/ontology/denominator_value> ;
                                                                owl:allValuesFrom xsd:decimal
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://w3id.org/omop/ontology/invalid_reason> ;
                                                                owl:allValuesFrom xsd:string
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://w3id.org/omop/ontology/numerator_value> ;
                                                                owl:allValuesFrom xsd:decimal
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://w3id.org/omop/ontology/valid_end_date> ;
                                                                owl:allValuesFrom xsd:date
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://w3id.org/omop/ontology/valid_start_date> ;
                                                                owl:allValuesFrom xsd:date
                                                              ] ;
                                              rdfs:comment "The DRUG_STRENGTH table contains structured content about the amount or concentration and associated units of a specific ingredient contained within a particular drug product. This table is supplemental information to support standardized analysis of drug utilization."@en ;
                                              rdfs:label "Drug strength" ;
                                              <https://w3id.org/omop/ontology/omop_cdm_name> "drug_strength" .


