                                                          owl:onProperty <https://w3id.org/omop/ontology/has_ethnicity_source> ;
                                                          owl:someValuesFrom <https://w3id.org/omop/ontology/Concept>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/omop/ontology/has_race> ;
                                                          owl:someValuesFrom <https://w3id.org/omop/ontology/Concept>
                                                        ] ,
