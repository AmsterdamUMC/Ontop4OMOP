                                                          owl:onProperty <https://w3id.org/omop/ontology/birth_datetime> ;
                                                          owl:allValuesFrom xsd:dateTime
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/omop/ontology/day_of_birth> ;
                                                          owl:allValuesFrom xsd:integer
                                                        ] ,
