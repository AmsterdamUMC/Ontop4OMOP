                                                        <http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#python_name> "stop_reason_source" ;
                                                        rdfs:comment "For Payer Plan Period: If the source data codes the stop reason in an OMOP supported vocabulary store the concept_id here."@en ;
                                                        rdfs:label "Has stop reason source" ;
                                                        <https://w3id.org/omop/ontology/omop_cdm_name> "payer_plan_period.stop_reason_source_concept_id#306 AS Concept" .


