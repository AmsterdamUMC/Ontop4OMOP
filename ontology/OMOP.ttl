                                                          owl:someValuesFrom <https://w3id.org/omop/ontology/Concept>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/omop/ontology/has_condition_era> ;
                                                          owl:allValuesFrom <https://w3id.org/omop/ontology/ConditionEra>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/omop/ontology/has_condition_occurrence> ;
                                                          owl:allValuesFrom <https://w3id.org/omop/ontology/ConditionOccurrence>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/omop/ontology/has_cost> ;
                                                          owl:allValuesFrom <https://w3id.org/omop/ontology/Cost>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/omop/ontology/has_death> ;
                                                          owl:allValuesFrom <https://w3id.org/omop/ontology/Death>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/omop/ontology/has_device_exposure> ;
